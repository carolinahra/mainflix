# Local PostgreSQL. For Neon, use its pooled connection URL with TLS enabled.
DATABASE_URL=postgres://mainflix:mainflix@localhost:55432/mainflix
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
PORT=3000
# Optional: TMDB API Read Access Token (bearer token), never a VITE_ variable.
TMDB_TOKEN=
# Tests deliberately use a separate database ending in _test.
TEST_DATABASE_URL=postgres://mainflix:mainflix@localhost:55433/mainflix_test
