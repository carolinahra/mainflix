{
  "name": "@mainflix/backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "NODE_ENV=development node --env-file-if-exists=../.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=../.env --import tsx --test --test-concurrency=1 test/*.test.ts",
    "db:migrate": "node --env-file-if-exists=../.env --import tsx src/cli.ts migrate",
    "user:create": "node --env-file-if-exists=../.env --import tsx src/cli.ts create-user",
    "user:reset": "node --env-file-if-exists=../.env --import tsx src/cli.ts reset-password"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "zod": "^4.0.0",
    "kysely": "^0.28.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
